{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/modals\/hosttoastpresenting"]}],"identifier":{"url":"doc:\/\/Modals\/documentation\/Modals\/HostToastPresenting","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Modals\/documentation\/Modals"]]},"metadata":{"role":"symbol","symbolKind":"protocol","externalID":"s:6Modals19HostToastPresentingP","modules":[{"name":"Modals"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"HostToastPresenting"}],"navigatorTitle":[{"kind":"identifier","text":"HostToastPresenting"}],"roleHeading":"Protocol","title":"HostToastPresenting"},"relationshipsSections":[{"type":"inheritsFrom","title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/Modals\/documentation\/Modals\/ModalHost"]},{"type":"conformingTypes","title":"Conforming Types","kind":"relationships","identifiers":["doc:\/\/Modals\/documentation\/Modals\/ModalHostContainerViewController"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HostToastPresenting","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"c:@M@Modals@objc(pl)MDLModalHost","text":"ModalHost","kind":"typeIdentifier","identifier":"doc:\/\/Modals\/documentation\/Modals\/ModalHost"}]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Toasts presented through "},{"type":"codeVoice","code":"contentToastPresenter"},{"type":"text","text":" are stored by the host’s content, so removing"},{"type":"text","text":" "},{"type":"text","text":"the triggering view controller from the hierarchy (e.g. with a navigation pop) does not dismiss"},{"type":"text","text":" "},{"type":"text","text":"them. As with any toast presentation, the returned "},{"type":"codeVoice","code":"ModalLifetime"},{"type":"text","text":" must be retained —"},{"type":"text","text":" "},{"type":"text","text":"deallocating it dismisses the toast — so retain it with an owner that outlives the triggering"},{"type":"text","text":" "},{"type":"text","text":"view controller."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storage and visibility have separate lifetimes: retaining the "},{"code":"ModalLifetime","type":"codeVoice"},{"type":"text","text":" keeps the toast"},{"type":"text","text":" "},{"type":"text","text":"stored by the content presenter, while the toast is visible only when the host is attached to"},{"type":"text","text":" "},{"type":"text","text":"an active modal-host hierarchy. Detaching a nested host removes its forwarded toast from the"},{"type":"text","text":" "},{"type":"text","text":"former ancestor without dismissing the retained lifetime."}]},{"type":"paragraph","inlineContent":[{"text":"Presented toasts participate in the host’s presentation filter like any other toast within","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"its content: with the default pass-through-toasts filter, a nested host forwards them to its"},{"type":"text","text":" "},{"text":"ancestor, so they are displayed by the outermost host.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To scope a toast’s lifetime to a particular view controller instead, use that view","type":"text"},{"text":" ","type":"text"},{"text":"controller’s ","type":"text"},{"type":"codeVoice","code":"toastPresenter"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can reach a host from any descendent view controller via "},{"code":"modalHost","type":"codeVoice"},{"type":"text","text":" or "},{"code":"rootModalHost","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["final class ToastCoordinator {","    private var toastLifetime: ModalLifetime?","","    func present(","        _ toastViewController: some UIViewController & ToastPresentable,","        from trigger: UIViewController","    ) {","        guard let host = trigger.rootModalHost as? HostToastPresenting else { return }","","        toastLifetime = host.contentToastPresenter.present(toastViewController)","    }","","    func dismissToast() {","        toastLifetime?.dismiss()","        toastLifetime = nil","    }","}"]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","topicSections":[{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/Modals\/documentation\/Modals\/HostToastPresenting\/contentToastPresenter"]}],"sections":[],"abstract":[{"type":"text","text":"A "},{"type":"reference","identifier":"x-source-tag:\/\/ModalHost","isActive":true},{"type":"text","text":" that can provide a "},{"type":"codeVoice","code":"ToastPresenter"},{"type":"text","text":" for presenting"},{"type":"text","text":" "},{"type":"text","text":"toasts scoped to the host’s content, rather than to the presenting view controller."}],"references":{"x-source-tag://ModalHost":{"url":"x-source-tag:\/\/ModalHost","title":"ModalHost","identifier":"x-source-tag:\/\/ModalHost","type":"link","titleInlineContent":[{"type":"text","text":"ModalHost"}]},"doc://Modals/documentation/Modals/ModalHost":{"role":"symbol","identifier":"doc:\/\/Modals\/documentation\/Modals\/ModalHost","navigatorTitle":[{"kind":"identifier","text":"ModalHost"}],"fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ModalHost"}],"type":"topic","url":"\/documentation\/modals\/modalhost","kind":"symbol","abstract":[{"type":"text","text":"This protocol indicates that a view controller acts as the host for modal presentation."}],"title":"ModalHost"},"doc://Modals/documentation/Modals/HostToastPresenting":{"role":"symbol","kind":"symbol","url":"\/documentation\/modals\/hosttoastpresenting","abstract":[{"type":"text","text":"A "},{"type":"reference","identifier":"x-source-tag:\/\/ModalHost","isActive":true},{"type":"text","text":" that can provide a "},{"type":"codeVoice","code":"ToastPresenter"},{"type":"text","text":" for presenting"},{"type":"text","text":" "},{"type":"text","text":"toasts scoped to the host’s content, rather than to the presenting view controller."}],"identifier":"doc:\/\/Modals\/documentation\/Modals\/HostToastPresenting","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HostToastPresenting","kind":"identifier"}],"navigatorTitle":[{"text":"HostToastPresenting","kind":"identifier"}],"type":"topic","title":"HostToastPresenting"},"doc://Modals/documentation/Modals/ModalHostContainerViewController":{"role":"symbol","identifier":"doc:\/\/Modals\/documentation\/Modals\/ModalHostContainerViewController","navigatorTitle":[{"text":"ModalHostContainerViewController","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"ModalHostContainerViewController","kind":"identifier"}],"url":"\/documentation\/modals\/modalhostcontainerviewcontroller","title":"ModalHostContainerViewController","type":"topic","abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" implementation that wraps another view controller."}],"kind":"symbol"},"doc://Modals/documentation/Modals/HostToastPresenting/contentToastPresenter":{"role":"symbol","identifier":"doc:\/\/Modals\/documentation\/Modals\/HostToastPresenting\/contentToastPresenter","url":"\/documentation\/modals\/hosttoastpresenting\/contenttoastpresenter","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"contentToastPresenter","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Modals14ToastPresenterP","kind":"typeIdentifier","text":"ToastPresenter"}],"required":true,"kind":"symbol","type":"topic","title":"contentToastPresenter","abstract":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"ToastPresenter"},{"text":" that presents toasts from the root of the host’s content, decoupling","type":"text"},{"text":" ","type":"text"},{"text":"their lifetime from any particular descendent view controller.","type":"text"}]},"doc://Modals/documentation/Modals":{"role":"collection","identifier":"doc:\/\/Modals\/documentation\/Modals","abstract":[],"url":"\/documentation\/modals","title":"Modals","type":"topic","kind":"symbol"}}}