{"abstract":[{"text":"A ","type":"text"},{"type":"reference","identifier":"x-source-tag:\/\/ModalHost","isActive":true},{"text":" that can provide a ","type":"text"},{"type":"codeVoice","code":"ToastPresenter"},{"text":" for presenting","type":"text"},{"text":" ","type":"text"},{"text":"toasts scoped to the host’s content, rather than to the presenting view controller.","type":"text"}],"sections":[],"relationshipsSections":[{"kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/Modals\/documentation\/Modals\/ModalHost"],"type":"inheritsFrom"},{"kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/Modals\/documentation\/Modals\/ModalHostContainerViewController"],"type":"conformingTypes"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"HostToastPresenting"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"ModalHost","identifier":"doc:\/\/Modals\/documentation\/Modals\/ModalHost","preciseIdentifier":"c:@M@Modals@objc(pl)MDLModalHost"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"text":"Toasts presented through ","type":"text"},{"code":"contentToastPresenter","type":"codeVoice"},{"text":" are stored by the host’s content, so removing","type":"text"},{"text":" ","type":"text"},{"text":"the triggering view controller from the hierarchy (e.g. with a navigation pop) does not dismiss","type":"text"},{"text":" ","type":"text"},{"text":"them. As with any toast presentation, the returned ","type":"text"},{"code":"ModalLifetime","type":"codeVoice"},{"text":" must be retained —","type":"text"},{"text":" ","type":"text"},{"text":"deallocating it dismisses the toast — so retain it with an owner that outlives the triggering","type":"text"},{"text":" ","type":"text"},{"text":"view controller.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Storage and visibility have separate lifetimes: retaining the ","type":"text"},{"code":"ModalLifetime","type":"codeVoice"},{"text":" keeps the toast","type":"text"},{"text":" ","type":"text"},{"text":"stored by the content presenter, while the toast is visible only when the host is attached to","type":"text"},{"text":" ","type":"text"},{"text":"an active modal-host hierarchy. Detaching a nested host removes its forwarded toast from the","type":"text"},{"text":" ","type":"text"},{"text":"former ancestor without dismissing the retained lifetime.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Presented toasts participate in the host’s presentation filter like any other toast within","type":"text"},{"text":" ","type":"text"},{"text":"its content: with the default pass-through-toasts filter, a nested host forwards them to its","type":"text"},{"text":" ","type":"text"},{"text":"ancestor, so they are displayed by the outermost host.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To scope a toast’s lifetime to a particular view controller instead, use that view","type":"text"},{"text":" ","type":"text"},{"text":"controller’s ","type":"text"},{"code":"toastPresenter","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can reach a host from any descendent view controller via ","type":"text"},{"code":"modalHost","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"rootModalHost","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["final class ToastCoordinator {","    private var toastLifetime: ModalLifetime?","","    func present(","        _ toastViewController: some UIViewController & ToastPresentable,","        from trigger: UIViewController","    ) {","        guard let host = trigger.rootModalHost as? HostToastPresenting else { return }","","        toastLifetime = host.contentToastPresenter.present(toastViewController)","    }","","    func dismissToast() {","        toastLifetime?.dismiss()","        toastLifetime = nil","    }","}"]}]}],"metadata":{"modules":[{"name":"Modals"}],"roleHeading":"Protocol","symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"HostToastPresenting"}],"externalID":"s:6Modals19HostToastPresentingP","role":"symbol","title":"HostToastPresenting","navigatorTitle":[{"text":"HostToastPresenting","kind":"identifier"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/modals\/hosttoastpresenting"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Modals\/documentation\/Modals\/HostToastPresenting"},"hierarchy":{"paths":[["doc:\/\/Modals\/documentation\/Modals"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"title":"Instance Properties","identifiers":["doc:\/\/Modals\/documentation\/Modals\/HostToastPresenting\/contentToastPresenter"],"anchor":"Instance-Properties","generated":true}],"kind":"symbol","references":{"doc://Modals/documentation/Modals/ModalHostContainerViewController":{"navigatorTitle":[{"kind":"identifier","text":"ModalHostContainerViewController"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ModalHostContainerViewController"}],"url":"\/documentation\/modals\/modalhostcontainerviewcontroller","title":"ModalHostContainerViewController","identifier":"doc:\/\/Modals\/documentation\/Modals\/ModalHostContainerViewController","type":"topic","role":"symbol","abstract":[{"text":"A ","type":"text"},{"code":"ModalHost","type":"codeVoice"},{"text":" implementation that wraps another view controller.","type":"text"}],"kind":"symbol"},"doc://Modals/documentation/Modals/HostToastPresenting":{"navigatorTitle":[{"kind":"identifier","text":"HostToastPresenting"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"HostToastPresenting"}],"url":"\/documentation\/modals\/hosttoastpresenting","title":"HostToastPresenting","identifier":"doc:\/\/Modals\/documentation\/Modals\/HostToastPresenting","type":"topic","role":"symbol","abstract":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"x-source-tag:\/\/ModalHost"},{"text":" that can provide a ","type":"text"},{"code":"ToastPresenter","type":"codeVoice"},{"text":" for presenting","type":"text"},{"text":" ","type":"text"},{"text":"toasts scoped to the host’s content, rather than to the presenting view controller.","type":"text"}],"kind":"symbol"},"x-source-tag://ModalHost":{"title":"ModalHost","type":"link","titleInlineContent":[{"type":"text","text":"ModalHost"}],"identifier":"x-source-tag:\/\/ModalHost","url":"x-source-tag:\/\/ModalHost"},"doc://Modals/documentation/Modals":{"kind":"symbol","url":"\/documentation\/modals","abstract":[],"type":"topic","title":"Modals","identifier":"doc:\/\/Modals\/documentation\/Modals","role":"collection"},"doc://Modals/documentation/Modals/HostToastPresenting/contentToastPresenter":{"abstract":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"ToastPresenter"},{"text":" that presents toasts from the root of the host’s content, decoupling","type":"text"},{"text":" ","type":"text"},{"text":"their lifetime from any particular descendent view controller.","type":"text"}],"type":"topic","url":"\/documentation\/modals\/hosttoastpresenting\/contenttoastpresenter","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"contentToastPresenter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Modals14ToastPresenterP","text":"ToastPresenter"}],"identifier":"doc:\/\/Modals\/documentation\/Modals\/HostToastPresenting\/contentToastPresenter","title":"contentToastPresenter","role":"symbol","required":true,"kind":"symbol"},"doc://Mo