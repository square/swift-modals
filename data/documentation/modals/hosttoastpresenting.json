{"sections":[],"topicSections":[{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/Modals\/documentation\/Modals\/HostToastPresenting\/contentToastPresenter"]}],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"HostToastPresenting"},{"text":" : ","kind":"text"},{"text":"ModalHost","kind":"typeIdentifier","preciseIdentifier":"c:@M@Modals@objc(pl)MDLModalHost","identifier":"doc:\/\/Modals\/documentation\/Modals\/ModalHost"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Toasts presented through ","type":"text"},{"type":"codeVoice","code":"contentToastPresenter"},{"type":"text","text":" are stored by the host’s content, so removing"},{"type":"text","text":" "},{"type":"text","text":"the triggering view controller from the hierarchy (e.g. with a navigation pop) does not dismiss"},{"text":" ","type":"text"},{"type":"text","text":"them. As with any toast presentation, the returned "},{"code":"ModalLifetime","type":"codeVoice"},{"text":" must be retained —","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"deallocating it dismisses the toast — so retain it with an owner that outlives the triggering"},{"type":"text","text":" "},{"text":"view controller.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storage and visibility have separate lifetimes: retaining the "},{"code":"ModalLifetime","type":"codeVoice"},{"type":"text","text":" keeps the toast"},{"type":"text","text":" "},{"type":"text","text":"stored by the content presenter, while the toast is visible only when the host is attached to"},{"type":"text","text":" "},{"type":"text","text":"an active modal-host hierarchy. Detaching a nested host removes its forwarded toast from the"},{"type":"text","text":" "},{"type":"text","text":"former ancestor without dismissing the retained lifetime."}]},{"type":"paragraph","inlineContent":[{"text":"Presented toasts participate in the host’s presentation filter like any other toast within","type":"text"},{"type":"text","text":" "},{"type":"text","text":"its content: with the default pass-through-toasts filter, a nested host forwards them to its"},{"text":" ","type":"text"},{"type":"text","text":"ancestor, so they are displayed by the outermost host."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To scope a toast’s lifetime to a particular view controller instead, use that view"},{"type":"text","text":" "},{"text":"controller’s ","type":"text"},{"type":"codeVoice","code":"toastPresenter"},{"text":".","type":"text"}]},{"inlineContent":[{"text":"You can reach a host from any descendent view controller via ","type":"text"},{"type":"codeVoice","code":"modalHost"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"rootModalHost"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["final class ToastCoordinator {","    private var toastLifetime: ModalLifetime?","","    func present(","        _ toastViewController: some UIViewController & ToastPresentable,","        from trigger: UIViewController","    ) {","        guard let host = trigger.rootModalHost as? HostToastPresenting else { return }","","        toastLifetime = host.contentToastPresenter.present(toastViewController)","    }","","    func dismissToast() {","        toastLifetime?.dismiss()","        toastLifetime = nil","    }","}"],"type":"codeListing"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"x-source-tag:\/\/ModalHost"},{"type":"text","text":" that can provide a "},{"type":"codeVoice","code":"ToastPresenter"},{"type":"text","text":" for presenting"},{"type":"text","text":" "},{"type":"text","text":"toasts scoped to the host’s content, rather than to the presenting view controller."}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"HostToastPresenting"}],"title":"HostToastPresenting","modules":[{"name":"Modals"}],"navigatorTitle":[{"text":"HostToastPresenting","kind":"identifier"}],"role":"symbol","externalID":"s:6Modals19HostToastPresentingP","symbolKind":"protocol","roleHeading":"Protocol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Modals\/documentation\/Modals\/HostToastPresenting"},"hierarchy":{"paths":[["doc:\/\/Modals\/documentation\/Modals"]]},"variants":[{"paths":["\/documentation\/modals\/hosttoastpresenting"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/Modals\/documentation\/Modals\/ModalHost"],"type":"inheritsFrom"},{"kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/Modals\/documentation\/Modals\/ModalHostContainerViewController"],"type":"conformingTypes"}],"references":{"doc://Modals/documentation/Modals/HostToastPresenting/contentToastPresenter":{"kind":"symbol","url":"\/documentation\/modals\/hosttoastpresenting\/contenttoastpresenter","title":"contentToastPresenter","identifier":"doc:\/\/Modals\/documentation\/Modals\/HostToastPresenting\/contentToastPresenter","role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contentToastPresenter","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Modals14ToastPresenterP","text":"ToastPresenter","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"ToastPresenter"},{"type":"text","text":" that presents toasts from the root of the host’s content, decoupling"},{"type":"text","text":" "},{"type":"text","text":"their lifetime from any particular descendent view controller."}],"required":true},"doc://Modals/documentation/Modals/HostToastPresenting":{"kind":"symbol","url":"\/documentation\/modals\/hosttoastpresenting","title":"HostToastPresenting","identifier":"doc:\/\/Modals\/documentation\/Modals\/HostToastPresenting","role":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HostToastPresenting","kind":"identifier"}],"abstract":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"x-source-tag:\/\/ModalHost"},{"type":"text","text":" that can provide a "},{"type":"codeVoice","code":"ToastPresenter"},{"type":"text","text":" for presenting"},{"type":"text","text":" "},{"type":"text","text":"toasts scoped to the host’s content, rather than to the presenting view controller."}],"navigatorTitle":[{"text":"HostToastPresenting","kind":"identifier"}]},"doc://Modals/documentation/Modals":{"title":"Modals","role":"collection","abstract":[],"url":"\/documentation\/modals","kind":"symbol","identifier":"doc:\/\/Modals\/documentation\/Modals","type":"topic"},"x-source-tag://ModalHost":{"url":"x-source-tag:\/\/ModalHost","title":"ModalHost","identifier":"x-source-tag:\/\/ModalHost","titleInlineContent":[{"type":"text","text":"ModalHost"}],"type":"link"},"doc://Modals/documentation/Modals/ModalHostContainerViewController":{"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ModalHostContainerViewController"}],"title":"ModalHostContainerViewController","navigatorTitle":[{"text":"ModalHostContainerViewController","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" implementation that wraps another view controller."}],"url":"\/documentation\/modals\/modalhostcontainerviewcontroller","identifier":"doc:\/\/Modals\/documentation\/Modals\/ModalHostContainerViewController","kind":"symbol","type":"topic"},"doc://Mo