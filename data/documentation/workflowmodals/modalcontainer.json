 are updated asynchronously, so this container won’t present or dismiss modals"},{"type":"text","text":" "},{"type":"text","text":"synchronously during the screen update of a workflow render."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/workflowmodals\/modalcontainer"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/WorkflowModals\/documentation\/WorkflowModals"]]},"references":{"doc://WorkflowModals/documentation/WorkflowModals/ModalContainer/SingleScreenContaining-Implementations":{"role":"collectionGroup","kind":"article","identifier":"doc:\/\/WorkflowModals\/documentation\/WorkflowModals\/ModalContainer\/SingleScreenContaining-Implementations","abstract":[],"type":"topic","title":"SingleScreenContaining Implementations","url":"\/documentation\/workflowmodals\/modalcontainer\/singlescreencontaining-implementations"},"doc://WorkflowModals/s9EscapableP":{"title":"Swift.Escapable","type":"unresolvable","identifier":"doc:\/\/WorkflowModals\/s9EscapableP"},"x-source-tag://ModalHost":{"title":"ModalHost","url":"x-source-tag:\/\/ModalHost","type":"link","identifier":"x-source-tag:\/\/ModalHost","titleInlineContent":[{"text":"ModalHost","type":"text"}]},"doc://WorkflowModals/documentation/WorkflowModals/ModalContainer/base":{"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"base","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14WorkflowModals14ModalContainerV11BaseContentxmfp","text":"BaseContent","kind":"typeIdentifier"}],"kind":"symbol","identifier":"doc:\/\/WorkflowModals\/documentation\/WorkflowModals\/ModalContainer\/base","abstract":[{"text":"The screen to render behind the modals. If there are no modals in the ","type":"text"},{"code":"modal","type":"codeVoice"},{"text":" array, this","type":"text"},{"text":" ","type":"text"},{"text":"screen will be rendered by the container.","typ