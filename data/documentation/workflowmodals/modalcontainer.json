{"text":" ","type":"text"},{"text":"in which case you do not need to use a ","type":"text"},{"type":"codeVoice","code":"ModalHostContainer"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Note that modals are updated asynchronously, so this container won’t present or dismiss modals","type":"text"},{"text":" ","type":"text"},{"text":"synchronously during the screen update of a workflow render.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://WorkflowModals/documentation/WorkflowModals/ModalContainer/base":{"abstract":[{"text":"The screen to render behind the modals. If there are no modals in the ","type":"text"},{"type":"codeVoice","code":"modal"},{"text":" array, this","type":"text"},{"text":" ","type":"text"},{"text":"screen will be rendered by the container.","type":"text"}],"type":"topic","role":"symbol","title":"base","identifier":"doc:\/\/WorkflowModals\/documentation\/WorkflowModals\/ModalContainer\/base","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"base"},{"kind":"text","text":": "},{"preciseIdentifier":"s:14WorkflowModals14ModalContainerV11BaseContentxmfp","kind":"typeIdentifier","text":"BaseContent"}],"url":"\/documentation\/workflowmodals\/modalcontainer\/base"},"doc://WorkflowModals/10WorkflowUI6ScreenP":{"title":"WorkflowUI.Screen","identifier":"doc:\/\/WorkflowModals\/10WorkflowUI6ScreenP","type":"unresolvable"},"doc://WorkflowModals/s8CopyableP":{"title":"Swift.Copyable","identifier":"doc:\/\/WorkflowModals\/s8CopyableP","type":"unresolvable"},"doc://WorkflowModals/documentation/WorkflowModals/ModalContainer/SingleScreenContaining-Implementations":{"role":"collectionGroup","url":"\/documentation\/workflowmodals\/modalcontainer\/singlescreencontaining-implementations","type":"topic","kind":"article","identifier":"doc:\/\/WorkflowModals\/documentation\/WorkflowModals\/ModalContainer\/SingleScreenContaining-Implementations","abs