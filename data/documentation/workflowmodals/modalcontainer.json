text":" instead,"},{"type":"text","text":" "},{"type":"text","text":"in which case you do not need to use a "},{"type":"codeVoice","code":"ModalHostContainer"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Note that modals are updated asynchronously, so this container won’t present or dismiss modals","type":"text"},{"type":"text","text":" "},{"type":"text","text":"synchronously during the screen update of a workflow render."}]}],"kind":"content"}],"references":{"doc://WorkflowModals/documentation/WorkflowModals":{"abstract":[],"url":"\/documentation\/workflowmodals","title":"WorkflowModals","type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/WorkflowModals\/documentation\/WorkflowModals"},"doc://WorkflowModals/s8CopyableP":{"type":"unresolvable","identifier":"doc:\/\/WorkflowModals\/s8CopyableP","title":"Swift.Copyable"},"doc://WorkflowModals/documentation/WorkflowModals/ModalContainer/base":{"title":"base","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"base","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BaseContent","kind":"typeIdentifier","preciseIdentifier":"s:14WorkflowModals14ModalContainerV11BaseContentxmfp"}],"abstract":[{"type":"text","text":"The screen to render behind the modals. If there are no modals in the "},{"code":"modal","type":"codeVoice"},{"type":"text","text":" array, this"},{"type":"text","text":" "},{"type":"text","text":"screen will be rendered by the container."}],"url":"\/documentation\/workflowmodals\/modalcontainer\/base","identifier":"doc:\/\/WorkflowModals\/documentation\/WorkflowModals\/ModalContainer\/base","kind":"symbol","role":"symbol","type":"topic"},"doc://WorkflowModals/documentation/WorkflowModals/ModalContainer":{"title":"ModalContainer","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ModalContainer","kind":"identifier"}],"abstract":[{"text":"Use a ","type":"text"},{"code":"ModalContainer","type":"